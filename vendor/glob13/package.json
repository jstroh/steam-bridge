{
  "author": "Isaac Z. Schlueter <i@izs.me> (https://blog.izs.me/)",
  "name": "steam-bridge-build-glob13",
  "description": "the most correct and second fastest glob implementation in JavaScript (Steam Bridge build-only security derivative)",
  "version": "13.0.6-steam-bridge.1",
  "type": "module",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/commonjs/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./raw": {
      "import": {
        "types": "./lib/esm/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    ".": {
      "import": {
        "types": "./lib/esm/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:isaacs/node-glob.git"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "minimatch": "^10.2.2",
    "minipass": "^7.1.3",
    "path-scurry": "^2.0.2"
  },
  "license": "BlueOak-1.0.0",
  "funding": {
    "url": "https://github.com/sponsors/isaacs"
  },
  "engines": {
    "node": "18 || 20 || >=22"
  },
  "private": true
}
