{
  "author": "Isaac Z. Schlueter <i@izs.me> (http://blog.izs.me)",
  "name": "steam-bridge-build-minimatch10",
  "description": "a glob matcher in javascript (Steam Bridge build-only security derivative)",
  "version": "10.2.6-steam-bridge.1",
  "repository": {
    "type": "git",
    "url": "git@github.com:isaacs/minimatch"
  },
  "main": "./lib/commonjs/index.js",
  "types": "./lib/commonjs/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
