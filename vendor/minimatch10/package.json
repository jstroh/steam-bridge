      "require": {
        "types": "./lib/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": "18 || 20 || >=22"
  },
  "funding": {
    "url": "https://github.com/sponsors/isaacs"
  },
  "license": "BlueOak-1.0.0",
  "type": "module",
  "module": "./lib/esm/index.js",
  "dependencies": {
    "brace-expansion": "^5.0.8"
  },
  "private": true
}
